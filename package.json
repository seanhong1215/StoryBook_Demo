{
  "name": "@seanhong1215/my-design-system",
  "private": false,
  "version": "0.1.0",
  "description": "A React design system with product-line theming, built with Vite and documented in Storybook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhong1215/StoryBook_Demo.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/my-design-system.umd.cjs",
  "module": "./dist/index.js",
  "style": "./dist/my-design-system.css",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/my-design-system.umd.cjs"
    },
    "./styles.css": "./dist/my-design-system.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode umd",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "preversion": "npm run verify",
    "prepublishOnly": "npm run verify",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest --project=storybook run",
    "test-storybook": "vitest --project=storybook run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx --yes chromatic --only-changed",
    "demo:sync": "node scripts/sync-demo.mjs",
    "demo:dev": "npm --prefix demo/product-a-demo run dev",
    "verify:pack": "node scripts/verify-pack.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-storybook.ps1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.6"
  }
}
